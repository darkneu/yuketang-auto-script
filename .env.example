# ============================================================
#  长江雨课堂自动刷课 + DeepSeek / Codex 智能答题  配置文件模板
#  使用方式：复制本文件为 .env 并填写实际值
#      cp .env.example .env
# ============================================================

# ---------- 站点配置 ----------
# 长江雨课堂域名（一般无需修改）
YUKETANG_DOMAIN=changjiang.yuketang.cn

# 学校 ID（university_id / uv_id）
# 获取方式：登录后打开 F12 -> Application -> Cookies -> university_id
UNIVERSITY_ID=

# ---------- 登录凭证（二选一）----------
# 方式 A：扫码登录（推荐，首次运行会自动弹出二维码，无需填写下面两项）
# 方式 B：手动填写 Cookie（从浏览器 F12 -> Application -> Cookies 复制）
CSRF_TOKEN=
SESSION_ID=
# 程序保存的登录所属学校；无需手动填写，清空上方学校输入不清除此会话信息
SESSION_UNIVERSITY_ID=

# ---------- AI 模式（只需修改这一项即可切换；不自动回退） ----------
# codex：本机已登录的 Codex CLI；deepseek：DeepSeek API
AI_MODE=deepseek

# ---------- DeepSeek API 配置（仅 AI_MODE=deepseek 时使用） ----------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 按账号可用模型填写；参考 https://api-docs.deepseek.com/quick_start/pricing/
# 可选模型：deepseek-v4-pro（推理更强）/ deepseek-flash（更快）
DEEPSEEK_MODEL=deepseek-flash
# 答题温度，越低越稳定（0.0 ~ 1.0）
DEEPSEEK_TEMPERATURE=0.3
# 每次 API 调用超时（秒）
DEEPSEEK_TIMEOUT=300

# ---------- Codex 配置（仅 AI_MODE=codex 时使用，无需 API Key） ----------
# 首次使用执行 codex login；用 codex login status 检查登录状态
# 如命令不在 PATH 中，可填写 codex.exe 的完整路径（有空格时加双引号）
CODEX_CLI=codex
# 留空使用 Codex CLI 的默认模型；不自动读取桌面端当前聊天的模型选择
CODEX_MODEL=
# 单道题调用超时（秒）
CODEX_TIMEOUT=300

# ---------- 视频刷课配置 ----------
# 是否启用视频任务（桌面端和 all 命令）
AUTO_VIDEO=true
# 播放倍速（服务端按倍速折算进度，建议 1.0 ~ 2.0，过高易被风控）
VIDEO_SPEED=2
# 心跳批量提交间隔（秒，至少 5 秒）；播放进度固定每 5 秒采样一次
HEARTBEAT_INTERVAL=15
# 并发刷课线程数（建议 1 ~ 4，过高易触发风控）
MAX_CONCURRENT_VIDEOS=2
# 是否跳过服务端标记完成或观看比例达到 100% 的视频
SKIP_COMPLETED=true
# 单次心跳请求最大重试次数
MAX_RETRIES=3

# ---------- 图文 / 讨论配置 ----------
# 是否自动完成图文（课件）打卡
AUTO_RICHTEXT=true
# 每篇图文模拟停留时间（秒）
RICHTEXT_STAY_SECONDS=3
# 是否自动完成讨论区发帖
AUTO_DISCUSSION=false

# ---------- 作业 / 考试配置 ----------
# 是否自动完成作业
AUTO_HOMEWORK=false
# 是否自动完成考试（风险较高，默认关闭）
AUTO_EXAM=false
# 保留配置：当前版本尚未实现人工确认，答题后会直接提交
HOMEWORK_CONFIRM=true

# ---------- 运行配置 ----------
# 测试模式：只处理前 N 个任务
TEST_MODE=false
TEST_TASK_COUNT=3
# 调试日志
DEBUG=false
# 日志文件路径
LOG_FILE=logs/yuketang.log
