# ============================================================
#  长江雨课堂自动刷课 + DeepSeek 智能答题  配置文件模板
#  使用方式：复制本文件为 .env 并填写实际值
#      cp .env.example .env
# ============================================================

# ---------- 站点配置 ----------
# 长江雨课堂域名（一般无需修改）
YUKETANG_DOMAIN=changjiang.yuketang.cn

# 学校 ID（university_id / uv_id）
# 获取方式：登录后打开 F12 -> Application -> Cookies -> university_id
UNIVERSITY_ID=

# ---------- 登录凭证（二选一）----------
# 方式 A：扫码登录（推荐，首次运行会自动弹出二维码，无需填写下面两项）
# 方式 B：手动填写 Cookie（从浏览器 F12 -> Application -> Cookies 复制）
CSRF_TOKEN=
SESSION_ID=

# ---------- DeepSeek 配置 ----------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选模型：deepseek-v4-pro（推理更强）/ deepseek-flash（更快）
DEEPSEEK_MODEL=deepseek-v4-pro
# 答题温度，越低越稳定（0.0 ~ 1.0）
DEEPSEEK_TEMPERATURE=0.3

# ---------- 视频刷课配置 ----------
# 播放倍速（服务端按倍速折算进度，建议 1.0 ~ 2.0，过高易被风控）
VIDEO_SPEED=1.5
# 心跳发送间隔（秒）
HEARTBEAT_INTERVAL=15
# 并发刷课线程数（建议 1 ~ 4，过高易触发风控）
MAX_CONCURRENT_VIDEOS=2
# 是否跳过已完成（完成率 >= 90%）的视频
SKIP_COMPLETED=true
# 单次心跳请求最大重试次数
MAX_RETRIES=3

# ---------- 图文 / 讨论配置 ----------
# 是否自动完成图文（课件）打卡
AUTO_RICHTEXT=true
# 每篇图文模拟停留时间（秒）
RICHTEXT_STAY_SECONDS=3
# 是否自动完成讨论区发帖
AUTO_DISCUSSION=false

# ---------- 作业 / 考试配置 ----------
# 是否自动完成作业
AUTO_HOMEWORK=false
# 是否自动完成考试（风险较高，默认关闭）
AUTO_EXAM=false
# 提交前是否需要人工确认（true 更安全）
HOMEWORK_CONFIRM=true

# ---------- 运行配置 ----------
# 测试模式：只处理前 N 个任务
TEST_MODE=false
TEST_TASK_COUNT=3
# 调试日志
DEBUG=false
# 日志文件路径
LOG_FILE=logs/yuketang.log
